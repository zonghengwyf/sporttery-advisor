# 竞彩足球顾问 — 环境变量配置
# 使用方法：cp .env.example .env，然后填写实际值
#
# Docker Compose 会从此文件读取配置。
# DATABASE_URL / REDIS_URL / DUCKDB_PATH / SKILLS_DIR 已在 docker-compose.yml
# 的 environment 块中固定（容器内部地址），无需在此重复配置。

# ── PostgreSQL 密码（同时用于 postgres 容器和 backend 连接串） ────────────────
# docker-compose 中使用 ${POSTGRES_PASSWORD:-sporttery} 展开
POSTGRES_PASSWORD=9yZW7rKgZ%Xp

# ── 应用安全密钥（JWT 签名，生产环境必须改为随机长字符串） ──────────────────────
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=0F0f68pc5dsJvmcJ8!To

# ── Token 有效期（分钟，默认 7 天） ──────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 首次启动自动创建管理员（留空 INITIAL_ADMIN_PASSWORD 则不创建） ─────────────
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin@123
INITIAL_ADMIN_EMAIL=admin@localhost

# ── 系统级 LLM（每日自动分析流水线使用；用户也可在设置页单独配置） ──────────────
# 支持的 provider：claude / openai / gemini / deepseek / kimi / glm / custom
#
# 选项 A：DeepSeek（国内直连，有免费额度，推荐）
SYSTEM_LLM_PROVIDER=deepseek
SYSTEM_LLM_MODEL=deepseek-chat
SYSTEM_LLM_API_KEY=
SYSTEM_LLM_BASE_URL=https://api.deepseek.com/v1
#
# 选项 B：Claude（需要 Anthropic API Key）
# SYSTEM_LLM_PROVIDER=claude
# SYSTEM_LLM_MODEL=claude-sonnet-4-6
# SYSTEM_LLM_API_KEY=sk-ant-...
# SYSTEM_LLM_BASE_URL=
#
# 选项 C：OpenAI
# SYSTEM_LLM_PROVIDER=openai
# SYSTEM_LLM_MODEL=gpt-4o
# SYSTEM_LLM_API_KEY=sk-...
# SYSTEM_LLM_BASE_URL=

# ── 每日自动调度时间（5 字段 Cron，容器时区 UTC+8） ───────────────────────────
DAILY_SYNC_CRON=0 8 * * *
DAILY_ANALYZE_CRON=0 9 * * *

# ── 数据源 API Key（全部可选，留空自动降级到免费源） ─────────────────────────
# 竞彩赛单/赔率：直接调用官方 App 内部接口（无需 Key，如需第三方备用 API 可配置）
SPORTTERY_API_KEY=
# The Odds API：提供海外参考赔率，留空则跳过（不影响核心功能）
ODDS_API_KEY=
# API-Football：提供伤停/阵容数据，留空则跳过（不影响核心功能）
API_FOOTBALL_KEY=
